# 基于 LLVM 风格定制
BasedOnStyle: LLVM

# 缩进宽度 4 个空格
IndentWidth: 4
UseTab: Never
TabWidth: 4

# 大括号风格：Attach（与声明/关键字同行）
BreakBeforeBraces: Attach

# 允许短控制语句块放在一行
AllowShortBlocksOnASingleLine: true
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline   # 仅内联函数或空函数可一行

# 指针和引用左对齐（紧贴类型名）
PointerAlignment: Left

# 连续空行最多保留 1 个（删除多余空行）
MaxEmptyLinesToKeep: 1

# 行宽限制（根据需求调整）
ColumnLimit: 100

# 控制语句（if/for/while）的括号前加空格
SpaceBeforeParens: ControlStatements

# 函数调用括号前不加空格（与 K&R 一致）
# 注意：此选项已由 SpaceBeforeParens: ControlStatements 控制，无需额外设置

# 类型转换后不加空格（对应 indent 的 -ncs）
SpaceAfterCStyleCast: false

# case 标签不缩进（对应 indent 的 -cli0，但这里保持默认不缩进）
IndentCaseLabels: false

# 二元运算符换行时，运算符放在行首（对应 -bbo）
BreakBeforeBinaryOperators: true
